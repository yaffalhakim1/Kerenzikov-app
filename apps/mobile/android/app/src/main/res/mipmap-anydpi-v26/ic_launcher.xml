<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon for Android 8.0+ (API 26). Devices on API 26 and
     above use this and mask it to their own shape; older devices fall back to
     the legacy `mipmap/ic_launcher.webp` squares.

     The foreground layer is the glyph on transparency, fitted to the centre
     66% safe zone by `scripts/icons.py`. The background is the icon's own
     dark ground, matching the mark rather than a flat theme colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/iconBackground" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
